# IDX Analyst Bot v4 — Environment Template

# WAJIB
DISCORD_TOKEN=your_discord_token
GROQ_API_KEY=your_groq_api_key
DAILY_CHANNEL_ID=123456789

# Multi-provider AI (optional; overrides GROQ_API_KEY when set).
# JSON array, tried from left to right. Use api_key_env for secrets.
# type=openai: Groq, OpenAI/ChatGPT, OpenRouter, Ollama, OpenCode, etc.
# type=anthropic: Claude native API.
# AI_PROVIDERS=[{"name":"groq","type":"openai","api_key_env":"GROQ_API_KEY","base_url":"https://api.groq.com/openai/v1","model":"llama-3.3-70b-versatile"},{"name":"ollama","type":"openai","api_key":"ollama","base_url":"http://localhost:11434/v1","model":"llama3.1"},{"name":"claude","type":"anthropic","api_key_env":"ANTHROPIC_API_KEY","model":"claude-3-5-sonnet-latest"}]

# OPTIONAL
SECTORS_API_KEY=your_sectors_key
REDIS_URL=redis://localhost:6379/0
PORT=8080
API_SECRET=replace_with_a_long_random_secret
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# FEATURE FLAGS
FEAT_RAG=false
FEAT_RISK=true
FEAT_SENT=true
FEAT_OPT=true
CHAT_CHANNEL_ALLOWLIST=

# SCHEDULER
DAILY_HOUR_UTC=1
DAILY_MINUTE=0
ALERT_CHECK_SECONDS=60

# LOGGING
ENV=production
LOG_LEVEL=INFO
LOG_FORMAT=json
